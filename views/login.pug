doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    meta(name='description' content='Sign in to Telesora to write, publish and manage your stories.')
    title Telesora | Sign in
    link(rel='icon' type='image/png' href='/images/telesora-logo-sm.png')
    link(rel='stylesheet' href='css/login.css')
  body.login-body
    main.login-shell
      aside.login-aside
        a.brand(href='/index')
          img.brand-logo(src='/images/telesora-logo-sm.png' alt='Telesora logo' width='48' height='32')
          span.brand-text Telesora
        p.eyebrow Welcome back
        h2.aside-title
          | Your stories are
          br
          span.gradient waiting for you.
        p.aside-copy
          | Pick up where you left off — draft, publish and manage
          | everything from one calm space.
        ul.aside-list
          li
            svg(viewBox='0 0 24 24' aria-hidden='true')
              path(d='M20 6 9 17l-5-5')
            span Draft and publish in seconds
          li
            svg(viewBox='0 0 24 24' aria-hidden='true')
              path(d='M20 6 9 17l-5-5')
            span Manage every post in one dashboard
          li
            svg(viewBox='0 0 24 24' aria-hidden='true')
              path(d='M20 6 9 17l-5-5')
            span Share stories with images and video
        p.aside-foot © #{new Date().getFullYear()} Telesora

      section.login-main
        .main-top
          a.home-link(href='/index')
            svg(viewBox='0 0 24 24' aria-hidden='true')
              path(d='M19 12H5')
              path(d='m12 19-7-7 7-7')
            span Back to home
        h1.form-title Sign in
        p.form-sub Enter your details to continue to your workspace.
        if error
          p.alert(role='alert')= error

        form.login-form(action='/login' method='post')
          .field
            label(for='email') Email address
            .control
              span.control-icon
                svg(viewBox='0 0 24 24' aria-hidden='true')
                  rect(x='3' y='5' width='18' height='14' rx='2')
                  path(d='m3 7 9 6 9-6')
              input#email(type='email' name='email' placeholder='you@example.com' autocomplete='email' required='')
          .field
            label(for='password') Password
            .control
              span.control-icon
                svg(viewBox='0 0 24 24' aria-hidden='true')
                  rect(x='3' y='11' width='18' height='10' rx='2')
                  path(d='M7 11V7a5 5 0 0 1 10 0v4')
              input#password(type='password' name='password' placeholder='Enter your password' autocomplete='current-password' required='')
              button.toggle(type='button' data-target='password' aria-label='Show password') Show
          button.btn.btn--primary(type='submit') Sign in

        p.form-foot
          | New to Telesora?
          a(href='/register') Create an account

    script.
      document.querySelectorAll('.toggle').forEach(function (button) {
        button.addEventListener('click', function () {
          var input = document.getElementById(button.dataset.target);
          var revealed = input.type === 'text';
          input.type = revealed ? 'password' : 'text';
          button.textContent = revealed ? 'Show' : 'Hide';
          button.setAttribute('aria-label', revealed ? 'Show password' : 'Hide password');
        });
      });
