doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    meta(name='description' content='Read the latest approved stories published on Telesora.')
    title Telesora | Stories
    link(rel='icon' type='image/png' href='/images/telesora-logo-sm.png')
    link(rel='stylesheet' href='/css/index.css')
    link(rel='stylesheet' href='/css/stories.css')
  body
    header.site-header
      nav.nav
        a.brand(href='/index')
          img.brand-logo(src='/images/telesora-logo-sm.png' alt='Telesora logo' width='48' height='32')
          span.brand-text Telesora
        .nav-links
          a.nav-link(href='/index') Home
          a.nav-link.nav-link--active(href='/stories') Stories
          if user
            a.nav-link(href='/dashboard') Dashboard
          else
            a.nav-link(href='/login') Login
          a.nav-link.nav-link--primary(href='/register') Get started

    main.stories-page
      section.stories-shell
        header.stories-head
          h1.stories-title Blog
          if stories.length
            span.stories-count
              | View All · #{stories.length} #{stories.length === 1 ? 'story' : 'stories'}

        if stories.length
          .story-grid
            each story in stories
              article.story-card
                .story-media
                  if story.mediaUrl && story.mediaType === 'video'
                    video.story-media-el(src=story.mediaUrl muted playsinline preload='metadata')
                  else if story.mediaUrl
                    img.story-media-el(src=story.mediaUrl alt=`Image for ${story.title}` loading='lazy')
                  else
                    .story-media-el.story-media--empty
                      span= story.initials
                  span.story-tag(title=story.category)= story.category
                .story-card-body
                  h2.story-title
                    a.story-link(href=`/stories/${story.id}`)= story.title
                  p.story-excerpt= story.excerpt
                  .story-meta
                    span.story-meta-item
                      svg(viewBox='0 0 24 24' aria-hidden='true')
                        rect(x='3' y='4.5' width='18' height='16' rx='2.5')
                        path(d='M3 9.5h18M8 2.8v3.4M16 2.8v3.4')
                      time(datetime=story.isoDate)= story.date
                    span.story-meta-item
                      svg(viewBox='0 0 24 24' aria-hidden='true')
                        circle(cx='12' cy='12' r='8.5')
                        path(d='M12 7.4V12l3.1 1.9')
                      span= story.readTime
                  a.story-more(href=`/stories/${story.id}`) Read More
        else
          .stories-empty
            h2 No stories published yet
            p
              | Approved stories will appear here. Be the first writer to
              | get one published.
            a.btn.btn--primary(href='/register') Start writing

    footer.site-footer
      .footer-inner
        span © #{new Date().getFullYear()} Telesora
        .footer-links
          a(href='/index') Home
          a(href='/stories') Stories
          a(href='/login') Login
          a(href='/register') Register
