doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    if story
      meta(name='description' content=(story.excerpt || story.description))
      title= `${story.title} — read on Telesora`
    else
      title= 'Story not found | Telesora'
    link(rel='icon' type='image/png' href='/images/telesora-logo-sm.png')
    include partials/theme-boot.pug
    link(rel='stylesheet' href='/css/index.css')
    link(rel='stylesheet' href='/css/story.css')
    link(rel='stylesheet' href='/css/notify.css')
    script(src='/js/theme.js' defer)
    script(src='/js/notifications.js' defer)
  body
    header.site-header
      nav.nav
        a.brand(href='/index')
          img.brand-logo(src='/images/telesora-logo-sm.png' alt='Telesora logo' width='48' height='32')
          span.brand-text Telesora
        .nav-right
          .nav-links
            a.nav-link(href='/index') Home
            a.nav-link(href='/stories') Stories
            if user
              a.nav-link(href='/dashboard') Dashboard
            else
              a.nav-link(href='/login') Login
            a.nav-link.nav-link--primary(href=user ? '/blogform' : '/register')= user ? 'Write a story' : 'Get started'
          include partials/nav-actions.pug

    main.story-page
      if story
        - const paragraphs = String(story.description || '').split(/\n\s*\n/).map((part) => part.trim()).filter(Boolean);
        - const hasLede = paragraphs.length > 1;
        - const mediaLabel = story.mediaType === 'video' ? 'Video' : 'Photograph';

        a.story-back(href='/stories')
          span.icon-back(aria-hidden='true') ←
          | Back to all stories

        article.story-article
          header.story-head
            .story-chips
              span.story-badge Published
              if story.readTime
                span.story-chip= story.readTime
            h1.story-title= story.title
            .story-byline
              span.story-avatar(aria-hidden='true')= story.initials
              .story-byline-copy
                span.story-author= `By ${story.authorName}`
                span.story-byline-meta
                  time.story-date(datetime=(story.isoDate || story.date))= story.date
                  if story.readTime
                    span.story-sep(aria-hidden='true') ·
                    span.story-readtime= story.readTime

          if story.mediaUrl
            figure.story-figure
              if story.mediaType === 'video'
                video.story-media(src=story.mediaUrl controls preload='metadata' playsinline)
              else
                img.story-media(src=story.mediaUrl alt=`${mediaLabel} accompanying the story "${story.title}"`)
              figcaption.story-caption #{mediaLabel} by #{story.authorName}

          .story-content
            each paragraph, index in paragraphs
              p(class=(hasLede && index === 0 ? 'story-lede' : null))= paragraph

        .story-end
          .story-end-rule
          p.story-end-kicker End of story
          p.story-end-note Thanks for reading. There is plenty more writing from the Telesora community waiting for you.
          .story-end-actions
            a.btn.btn--ghost(href='/stories') Browse more stories
            a.btn.btn--primary(href=user ? '/blogform' : '/register')= user ? 'Write your own story' : 'Start writing'
      else
        .story-missing
          span.story-missing-code 404
          h1 We couldn't find that story
          p
            | The link may be broken, or this story hasn't been published yet.
            | Try the story library instead.
          .story-missing-actions
            a.btn.btn--primary(href='/stories') Browse all stories
            a.btn.btn--ghost(href='/index') Go to homepage

    footer.site-footer
      .footer-inner
        span © #{new Date().getFullYear()} Telesora
        .footer-links
          a(href='/index') Home
          a(href='/stories') Stories
          a(href='/login') Login
          a(href='/register') Register
