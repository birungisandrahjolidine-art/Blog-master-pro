doctype html
html(lang='en')
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    meta(name='description' content='Review story submissions and track their approval status on Telesora.')
    title Telesora | #{user && user.role === 'admin' ? 'Review submissions' : 'Your stories'}
    link(rel='icon' type='image/png' href='/images/telesora-logo-sm.png')
    include partials/theme-boot.pug
    link(rel='stylesheet' href='/css/dashboard.css')
    link(rel='stylesheet' href='/css/notify.css')
    script(src='/js/theme.js' defer)
    script(src='/js/dashboard.js' defer)
    script(src='/js/notifications.js' defer)
  body.dashboard-body
    - const isAdmin = Boolean(user && user.role === 'admin')
    - const totalStories = isAdmin ? pendingBlogs.length + reviewedBlogs.length : dbBlogs.length
    - const hasStories = totalStories > 0
    - const adminStories = isAdmin ? pendingBlogs.concat(reviewedBlogs) : dbBlogs
    -
      const authorNames = Array.from(new Set(adminStories.map((blog) => {
        const author = blog.author || {}
        return [author.firstname, author.lastname].filter(Boolean).join(' ').trim()
      }).filter(Boolean))).sort((a, b) => a.localeCompare(b))
    - const newestStamp = adminStories.reduce((latest, blog) => (blog.createdAt && new Date(blog.createdAt) > latest ? new Date(blog.createdAt) : latest), new Date(0))

    nav.navbar
      .nav-container
        a.nav-logo(href='/index')
          img(src='/images/telesora-logo-sm.png' alt='' width='38' height='26')
          span Telesora
        .nav-right
          ul.nav-links
            li
              a(href='/index') Home
            li
              a(href='/stories') Stories
            if !isAdmin
              li
                a.nav-new(href='/blogform') + New story
            li
              a.logout-link(href='/logout') Log out
          include partials/nav-actions.pug

    main.dashboard
      header.dashboard-header
        .heading-copy
          p.eyebrow= isAdmin ? 'CONTENT MODERATION' : 'YOUR WRITING SPACE'
          h1= isAdmin ? 'Review submissions' : 'Your stories'
          p.welcome-msg
            if isAdmin
              | Keep the community thoughtful. Review new stories before they go live.
            else
              | Track your stories and see when they are ready to be published.
        .header-actions
          a.btn.btn-primary(href=isAdmin ? '/stories' : '/blogform')= isAdmin ? 'View published stories' : '+ Post a blog'

      if error
        p.alert(role='alert')= error

      section.stats-grid(aria-label='Submission totals')
        article.stat-card.stat-pending
          span.stat-icon(aria-hidden='true')
            svg(viewBox='0 0 24 24')
              circle(cx='12' cy='12' r='9')
              path(d='M12 7.4V12l3.1 1.9')
          .stat-body
            span.stat-label Awaiting review
            strong.stat-number= stats.pending
            span.stat-note= isAdmin ? 'Stories need your attention' : 'Stories being reviewed'
        article.stat-card.stat-approved
          span.stat-icon(aria-hidden='true')
            svg(viewBox='0 0 24 24')
              circle(cx='12' cy='12' r='9')
              path(d='m8.1 12.2 2.7 2.7 5.2-5.6')
          .stat-body
            span.stat-label Approved
            strong.stat-number= stats.approved
            span.stat-note Published for readers
        article.stat-card.stat-rejected
          span.stat-icon(aria-hidden='true')
            svg(viewBox='0 0 24 24')
              circle(cx='12' cy='12' r='9')
              path(d='M12 7.6v5.2M12 16.3v.1')
          .stat-body
            span.stat-label= isAdmin ? 'Rejected' : 'Needs changes'
            strong.stat-number= stats.rejected
            span.stat-note= isAdmin ? 'Not approved' : 'Review your story'

      if hasStories
        section.workspace-toolbar(aria-label='Search, filter, and sort stories')
          .search-field
            span.search-icon(aria-hidden='true')
              svg(viewBox='0 0 24 24')
                circle(cx='11' cy='11' r='6.6')
                path(d='m16 16 4.2 4.2')
            label.visually-hidden(for='story-search') Search stories
            input#story-search.search-input(type='search' placeholder='Search by title, author, or status' autocomplete='off')
            button.search-clear#search-clear(type='button' aria-label='Clear search' hidden)
              svg(viewBox='0 0 24 24' aria-hidden='true')
                path(d='M6.5 6.5l11 11M17.5 6.5l-11 11')
          .filter-group(role='group' aria-label='Filter stories by status')
            button.filter-tab.is-active(type='button' data-filter='all' aria-pressed='true')
              span All
              span.filter-count(data-filter-count='all')= totalStories
            button.filter-tab(type='button' data-filter='pending' aria-pressed='false')
              span Pending
              span.filter-count(data-filter-count='pending')= stats.pending
            button.filter-tab(type='button' data-filter='approved' aria-pressed='false')
              span Approved
              span.filter-count(data-filter-count='approved')= stats.approved
            button.filter-tab(type='button' data-filter='rejected' aria-pressed='false')
              span= isAdmin ? 'Rejected' : 'Needs changes'
              span.filter-count(data-filter-count='rejected')= stats.rejected
          .toolbar-filters
            .sort-field
              label.sort-label(for='story-sort') Sort
              .select-wrap
                select#story-sort.select-input(name='sort')
                  option(value='newest') Newest first
                  option(value='oldest') Oldest first
                  option(value='title') Title (A-Z)
                svg(viewBox='0 0 24 24' aria-hidden='true')
                  path(d='m6.5 9.5 5.5 5.5 5.5-5.5')
            if isAdmin
              .refine-group(role='group' aria-label='Refine stories by author and attachment')
                .sort-field.refine-field
                  label.sort-label(for='story-author') Author
                  .select-wrap
                    select#story-author.select-input(name='author')
                      option(value='all') All authors
                      each authorOption in authorNames
                        option(value=authorOption.toLowerCase())= authorOption
                    svg(viewBox='0 0 24 24' aria-hidden='true')
                      path(d='m6.5 9.5 5.5 5.5 5.5-5.5')
                .sort-field.refine-field
                  label.sort-label(for='story-media') Attachment
                  .select-wrap
                    select#story-media.select-input(name='media')
                      option(value='all') Any attachment
                      option(value='image') Image
                      option(value='video') Video
                      option(value='none') Text only
                    svg(viewBox='0 0 24 24' aria-hidden='true')
                      path(d='m6.5 9.5 5.5 5.5 5.5-5.5')
        p.visually-hidden#results-status(role='status' aria-live='polite')

      if isAdmin
        section.story-section(data-story-section aria-labelledby='pending-heading')
          .section-heading
            div
              p.section-kicker MODERATION QUEUE
              h2#pending-heading Waiting for your review
            span.section-count(data-section-count)= pendingBlogs.length
          if pendingBlogs.length
            .story-grid
              each blog in pendingBlogs
                - const pendingName = blog.author && blog.author.firstname ? `${blog.author.firstname} ${blog.author.lastname || ''}`.trim() : 'Unknown author'
                - const pendingStamp = blog.createdAt ? new Date(blog.createdAt).toISOString() : ''
                - const pendingSearch = [blog.title, blog.description, pendingName, 'pending review'].join(' ').toLowerCase()
                - const pendingMedia = blog.media && blog.media.url ? (blog.media.type === 'video' ? 'video' : 'image') : 'none'
                article.story-card(data-story-card data-status='pending' data-created=pendingStamp data-title=blog.title data-search=pendingSearch data-author=pendingName.toLowerCase() data-media=pendingMedia)
                  if blog.media && blog.media.url && blog.media.type !== 'video'
                    .story-cover
                      img(src=blog.media.url alt='')
                  else
                    .story-cover.story-cover--empty
                      if blog.media && blog.media.type === 'video'
                        span.media-chip Video attached
                      else
                        span.cover-mark T
                  .story-content
                    .story-meta
                      span.status-label.pending Pending review
                      time(datetime=pendingStamp)= blog.createdAt ? new Date(blog.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Date unavailable'
                    h3.story-title= blog.title
                    p.story-description= blog.description
                    .author-line
                      span.author-avatar= blog.author && blog.author.firstname ? blog.author.firstname.charAt(0).toUpperCase() : 'A'
                      span
                        small Submitted by
                        strong= pendingName
                    .card-actions
                      form.status-form(action=`/blogs/status/${blog._id}` method='POST')
                        .status-dropdown
                          button.btn.btn-review.status-toggle(type='button' aria-haspopup='menu' aria-expanded='false' aria-label=`Update status for ${blog.title}`)
                            span Update status
                            svg(viewBox='0 0 24 24' aria-hidden='true')
                              path(d='m6 9 6 6 6-6')
                          .status-menu(role='menu' aria-label=`Change status for ${blog.title}`)
                            button.status-option(type='submit' name='status' value='approved' role='menuitem')
                              span.option-dot(aria-hidden='true')
                              span Approve
                            button.status-option(type='submit' name='status' value='rejected' role='menuitem')
                              span.option-dot(aria-hidden='true')
                              span Reject
                            button.status-option(type='submit' name='status' value='pending' role='menuitem')
                              span.option-dot(aria-hidden='true')
                              span Keep pending
                      a.btn-text(href=`/blogs/edit/${blog._id}`) Edit story
          else
            .empty-state
              span.empty-icon
                svg(viewBox='0 0 24 24' aria-hidden='true')
                  path(d='m5 12 4 4L19 6')
              h3 All caught up
              p There are no stories waiting for approval right now.

        section.story-section.reviewed-section(data-story-section aria-labelledby='reviewed-heading')
          .section-heading
            div
              p.section-kicker HISTORY
              h2#reviewed-heading Reviewed stories
            span.section-count(data-section-count)= reviewedBlogs.length
          if reviewedBlogs.length
            .reviewed-grid
              each blog in reviewedBlogs
                - const reviewedName = blog.author && blog.author.firstname ? `${blog.author.firstname} ${blog.author.lastname || ''}`.trim() : 'Unknown author'
                - const reviewedStamp = blog.createdAt ? new Date(blog.createdAt).toISOString() : ''
                - const reviewedStatus = blog.approveStatus === 'approved' ? 'Approved' : blog.approveStatus === 'rejected' ? 'Rejected' : 'Pending'
                - const reviewedSearch = [blog.title, blog.description, reviewedName, reviewedStatus].join(' ').toLowerCase()
                - const reviewedMedia = blog.media && blog.media.url ? (blog.media.type === 'video' ? 'video' : 'image') : 'none'
                article.reviewed-card(class=`reviewed-card--${blog.approveStatus}` data-story-card data-status=blog.approveStatus data-created=reviewedStamp data-title=blog.title data-search=reviewedSearch data-author=reviewedName.toLowerCase() data-media=reviewedMedia)
                  .reviewed-top
                    span.status-label(class=blog.approveStatus)= blog.approveStatus
                    time.reviewed-date(datetime=reviewedStamp)= blog.createdAt ? new Date(blog.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Date unavailable'
                  h3.story-title.reviewed-title= blog.title
                  p.reviewed-excerpt= blog.description
                  .reviewed-author
                    span.author-avatar= blog.author && blog.author.firstname ? blog.author.firstname.charAt(0).toUpperCase() : 'A'
                    span
                      small By
                      strong= reviewedName
                  .reviewed-actions
                    form.status-form.status-form--compact(action=`/blogs/status/${blog._id}` method='POST')
                      .status-dropdown
                        button.btn.btn-review.status-toggle(type='button' aria-haspopup='menu' aria-expanded='false' aria-label=`Change status for ${blog.title}`)
                          span= reviewedStatus
                          svg(viewBox='0 0 24 24' aria-hidden='true')
                            path(d='m6 9 6 6 6-6')
                        .status-menu.status-menu--end(role='menu' aria-label=`Change status for ${blog.title}`)
                          button.status-option(type='submit' name='status' value='approved' role='menuitem')
                            span.option-dot(aria-hidden='true')
                            span Approve
                          button.status-option(type='submit' name='status' value='rejected' role='menuitem')
                            span.option-dot(aria-hidden='true')
                            span Reject
                          button.status-option(type='submit' name='status' value='pending' role='menuitem')
                            span.option-dot(aria-hidden='true')
                            span Keep pending
                    form.delete-form(action=`/blogs/delete/${blog._id}` method='POST' onsubmit="return confirm('Delete this story? This cannot be undone.')")
                      button.btn-delete(type='submit' aria-label=`Delete ${blog.title}`) Delete
          else
            p.subtle-empty No reviewed stories yet.

      else
        section.story-section(data-story-section aria-labelledby='submissions-heading')
          .section-heading
            div
              p.section-kicker SUBMISSION HISTORY
              h2#submissions-heading Your submissions
            span.section-count(data-section-count)= dbBlogs.length
          if dbBlogs.length
            .story-grid
              each blog in dbBlogs
                - const authorName = blog.author && blog.author.firstname ? `${blog.author.firstname} ${blog.author.lastname || ''}`.trim() : 'Unknown author'
                - const storyStamp = blog.createdAt ? new Date(blog.createdAt).toISOString() : ''
                - const storyStatus = blog.approveStatus === 'approved' ? 'Approved' : blog.approveStatus === 'rejected' ? 'Needs changes' : 'Pending review'
                - const storySearch = [blog.title, blog.description, authorName, storyStatus].join(' ').toLowerCase()
                - const storyMedia = blog.media && blog.media.url ? (blog.media.type === 'video' ? 'video' : 'image') : 'none'
                article.story-card(data-story-card data-status=blog.approveStatus data-created=storyStamp data-title=blog.title data-search=storySearch data-author=authorName.toLowerCase() data-media=storyMedia)
                  if blog.media && blog.media.url && blog.media.type !== 'video'
                    .story-cover
                      img(src=blog.media.url alt='')
                  else
                    .story-cover.story-cover--empty
                      if blog.media && blog.media.type === 'video'
                        span.media-chip Video attached
                      else
                        span.cover-mark T
                  .story-content
                    .story-meta
                      span.status-label(class=blog.approveStatus)= storyStatus
                      time(datetime=storyStamp)= blog.createdAt ? new Date(blog.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Date unavailable'
                    h3.story-title= blog.title
                    p.story-description= blog.description
                    .author-line
                      span.author-avatar= blog.author && blog.author.firstname ? blog.author.firstname.charAt(0).toUpperCase() : 'A'
                      span
                        small Submitted by
                        strong= authorName
                    .card-actions
                      if blog.approveStatus === 'approved'
                        a.btn.btn-review(href=`/stories/${blog._id}`) Read story
                        a.btn-text(href=`/blogs/edit/${blog._id}`) Edit story
                      else
                        a.btn.btn-review(href=`/blogs/edit/${blog._id}`) Edit story
                        form.delete-form(action=`/blogs/delete/${blog._id}` method='POST' onsubmit="return confirm('Delete this story? This cannot be undone.')")
                          button.btn-delete(type='submit' aria-label=`Delete ${blog.title}`) Delete
          else
            .empty-state
              span.empty-icon
                svg(viewBox='0 0 24 24' aria-hidden='true')
                  path(d='M12 5v14M5 12h14')
              h3 Your next story starts here
              p You have not submitted a story yet. When you do, its review status will appear here.
              a.btn.btn-primary(href='/blogform') Write your first story

      .no-results#no-results(hidden)
        span.empty-icon
          svg(viewBox='0 0 24 24' aria-hidden='true')
            circle(cx='11' cy='11' r='6.6')
            path(d='m16 16 4.2 4.2')
        h3 No stories match your view
        p Try a different search term, or reset the filters to see everything again.
        button.btn.btn-ghost#clear-filters(type='button') Clear filters
